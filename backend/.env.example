# KMRL Metro Rail Backend Environment Configuration Template
# Duplicate this file to .env and fill in with your actual credentials

PORT=5000

# MongoDB Atlas or Local MongoDB Connection String
MONGO_DB_ATLAS_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=kmrl_metro

# JWT Authentication Secret
JWT_SECRET=your_secure_jwt_secret_here

# Razorpay Payment Gateway Credentials (Test or Production)
RAZORPAY_API_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Email Dispatch Configuration (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
